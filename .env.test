# Valores dummy para que Firebase inicialice sin errores durante los tests.
# No son credenciales reales: Vitest los carga en modo test, sin depender
# de que exista un .env local con secretos (por eso este archivo SÍ se sube).
VITE_FIREBASE_API_KEY=test-api-key-000000000000000000
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
